# Copy to .env and fill in for local development.
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time — never put secrets here.
# The mobile app has no secrets of its own (no auth system, INV per SPECS.md §12); this is
# purely the backend's HTTP base URL, which differs per environment/build profile.

# Local dev: point at the backend repo running on your machine (or your LAN IP if testing
# on a physical device via Expo Go, since "localhost" on-device means the device itself).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
